use arrays
use strings

use "screen.nt" as term_screen

use term_native

/// Wait up to `timeout_ms` for a key press; `""` means nothing arrived.
///
/// The returned name is one of `character`, `space`, `enter`, `escape`,
/// `tab`, `backspace`, `delete`, `home`, `end`, `page_up`, `page_down`,
/// `up`, `down`, `left`, `right`, `ctrl_c`, or `other`.
fun read_key(int handle, float timeout_ms) -> string {
    if (term_native.poll_key(handle, timeout_ms)) {
        return term_native.key_code()
    }
    return ""
}

/// The character of the last key returned by `read_key`, if it was one.
fun key_character() -> string {
    return term_native.key_character()
}

/// Whether the last key returned by `read_key` used Control.
fun key_ctrl() -> bool {
    return term_native.key_ctrl()
}

/// Read one line in raw mode: echo, backspace, Enter to finish.
///
/// Control-C abandons the line and returns `""`.
fun read_line(int handle) -> string {
    var buffer = ""
    var running = true
    while (running) {
        var key = read_key(handle, 86400000.0)
        if (key == "enter") {
            running = false
        } else if (key == "ctrl_c") {
            running = false
            buffer = ""
        } else if (key == "backspace") {
            if (!strings.is_empty(buffer)) {
                buffer = drop_last(buffer)
                term_screen.move_left(1)
                term_screen.clear_to_end()
            }
        } else if ((key == "character" || key == "space") && !term_native.key_ctrl()) {
            var character = term_native.key_character()
            buffer = buffer + character
            term_screen.write(character)
        }
    }
    return buffer
}

/// Write `question` and read one line.
fun prompt(int handle, view string question) -> string {
    term_screen.write(question)
    return read_line(handle)
}

/// Ask a yes/no question; anything but `y` or `Y` is no.
fun confirm(int handle, view string question) -> bool {
    term_screen.write(copy(question) + " [y/N] ")
    read_key(handle, 86400000.0)
    var character = strings.lower(term_native.key_character())
    term_screen.write_line(character)
    return character == "y"
}

/// Choose from `options` with the arrow keys; `-1` when cancelled.
fun select(int handle, view string question, view array[string] options) -> int {
    var count = arrays.length(options)
    if (count == 0) {
        return -1
    }
    term_screen.write_line(question)
    for (var i = 0; i < count; i = i + 1) {
        term_screen.write_line("")
    }
    var index = 0
    var running = true
    while (running) {
        draw_options(options, index)
        var key = read_key(handle, 86400000.0)
        if (key == "up") {
            index = index - 1
            if (index < 0) {
                index = count - 1
            }
        } else if (key == "down") {
            index = index + 1
            if (index >= count) {
                index = 0
            }
        } else if (key == "enter") {
            running = false
        } else if (key == "ctrl_c") {
            running = false
            index = -1
        }
    }
    return index
}

/// `text` without its last character, respecting UTF-8 boundaries.
private fun drop_last(view string text) -> string {
    var length = strings.length(text)
    if (length == 0) {
        return ""
    }
    var end = length - 1
    while (end > 0) {
        var byte = strings.char_code(text, end)
        if ((byte & 192) != 128) {
            break
        }
        end = end - 1
    }
    return strings.substring(text, 0, end)
}

/// Redraw the option list in place, with `selected` marked.
private fun draw_options(view array[string] options, int selected) {
    var count = arrays.length(options)
    for (var i = 0; i < count; i = i + 1) {
        term_screen.clear_line()
        if (i == selected) {
            term_screen.write_line("> " + copy(arrays.get(options, i)))
        } else {
            term_screen.write_line("  " + copy(arrays.get(options, i)))
        }
    }
    term_screen.move_up(count)
}
